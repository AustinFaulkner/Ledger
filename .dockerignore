# Keep the build context tiny and the image clean — only source + lockfiles are sent.
.git
.gitignore
**/__pycache__
*.py[cod]
.venv
venv
.pytest_cache
.ruff_cache
.mypy_cache

# Frontend deps/artifacts (rebuilt inside the image from the lockfile)
frontend/node_modules
frontend/dist

# Windows desktop build (PyInstaller) — not used by the Linux image
dist_exe
build_exe_tmp
build*.log
*.spec
desktop.py

# Local data, prefetched model, secrets
data
models
.env
*.log
eval
docs
