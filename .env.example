# ============================================================
#  Model backend — bring ANY provider token
# ============================================================
# Drop in a token and the app auto-detects the provider. Or set LLM_PROVIDER
# explicitly. Works with OpenAI, Anthropic/Claude, Alibaba/DashScope, OpenRouter,
# Together, Fireworks, DeepInfra, AWS Bedrock, self-hosted vLLM, or any other
# OpenAI-compatible endpoint.

# --- 1) Paste your token (any provider) ---
LLM_API_KEY=
# (Standard vars also work if you prefer: ANTHROPIC_API_KEY, OPENAI_API_KEY,
#  OPENROUTER_API_KEY, TOGETHER_API_KEY, DASHSCOPE_API_KEY, FIREWORKS_API_KEY.)

# --- 2) Provider (default: auto-detect from the token) ---
LLM_PROVIDER=auto
#   auto       detect from token prefix (sk-ant-→anthropic, sk-or-→openrouter, …)
#   openai | anthropic | openrouter | together | fireworks | dashscope | deepinfra | bedrock
#   For any other OpenAI-compatible vendor: LLM_PROVIDER=openai + set LLM_BASE_URL.

# --- 3) Model id (as your provider names it) ---
LLM_MODEL=qwen/qwen3-30b-a3b-thinking-2507
#   anthropic: claude-opus-4-8     openai: gpt-4o-mini     dashscope: qwen2.5-72b-instruct

# --- Two-tier models (optional; default to LLM_MODEL) ---
# Heavy reasoning (QoE generation) vs. fast interactive (chat Q&A). A thinking model
# for analysis + a non-thinking model for chat gives the best accuracy/latency tradeoff.
LLM_MODEL_REASONING=qwen/qwen3-30b-a3b-thinking-2507
LLM_MODEL_FAST=qwen/qwen3-30b-a3b-instruct-2507

# --- Optional: only needed for a custom / self-hosted endpoint ---
# LLM_BASE_URL=http://localhost:8000/v1     # vLLM, or any OpenAI-compatible URL

# --- Bedrock only (uses the AWS credential chain, not a single token) ---
AWS_REGION=us-east-1

# --- Local data ---
QOE_DATA_ROOT=./data
# QOE_MODEL_CACHE=./models    # where the local embedding model lives
