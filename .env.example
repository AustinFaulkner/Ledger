# Copy this file to .env and fill in your API key.

# API key for any OpenAI-compatible LLM provider.
# (ANTHROPIC_API_KEY / OPENAI_API_KEY / OPENROUTER_API_KEY also work.)
LLM_API_KEY=

# Provider — "auto" detects it from the token, or set one explicitly:
# openai | anthropic | openrouter | together | fireworks | dashscope | deepinfra | bedrock
LLM_PROVIDER=auto

# Models: a thinking model for analysis, a faster one for chat.
LLM_MODEL_REASONING=qwen/qwen3-30b-a3b-thinking-2507
LLM_MODEL_FAST=qwen/qwen3-30b-a3b-instruct-2507

# Optional: a custom OpenAI-compatible endpoint (self-hosted vLLM, Azure, etc.).
# LLM_BASE_URL=http://localhost:8000/v1

# Optional: how structured output is requested.
#   schema (default) — grammar-enforced JSON schema; the JSON always parses.
#   object           — response_format=json_object; use if a provider's strict
#                      mode is unreliable (some models decode to max_tokens under it).
#   none             — prompt-only, no response_format.
# LLM_JSON_MODE=schema

# Optional: AWS region (Bedrock only — uses the AWS credential chain).
# AWS_REGION=us-east-1

# Where the app stores its data (SQLite + uploaded files).
QOE_DATA_ROOT=./data
