# Normalize line endings: store LF in the repo, check out LF everywhere (consistent
# across Windows/macOS/Linux and CI). Avoids the LF↔CRLF churn git warned about.
* text=auto eol=lf

# Windows scripts must stay CRLF to run correctly
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Binary assets — never munge line endings or attempt text diffs
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.xlsx binary
*.xls  binary
*.pptx binary
*.docx binary
*.onnx binary
*.woff  binary
*.woff2 binary
